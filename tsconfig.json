{
  "compilerOptions": {
    "baseUrl": "./src",
    "lib": ["ES2020", "DOM"],
    "outDir": "./dist/",
    "noImplicitAny": true,
    "module": "es6",
    "target": "ES2020",
    "esModuleInterop": true,
    "jsx": "react",
    "allowJs": true,
    "moduleResolution": "Node",
    "paths": {
      "*": ["*"]
    },
    "strict": true,
    "types": ["jest", "node"]
  },
  "exclude": ["node_modules", "dist"]
}
