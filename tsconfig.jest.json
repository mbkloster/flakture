{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": ".",
    "outDir": "./.ts-jest",
    "types": [
      "jest",
      "node"
    ],
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "noEmit": false
  },
  "include": [
    "./tests/**/*.ts",
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
